# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/

# Enviroments variables
.env
.env.*

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Datos versionados con DVC: se versiona el .dvc, nunca el dato
/datasets/*
!/datasets/*.dvc
!/datasets/.gitignore
!/datasets/README.md

# Store centralizado de MLflow: estado generado, se recrea al entrenar
/.mlflow/

# Nota: las salidas de ejecucion (artifacts/, models/, mlruns/, reports/)
# se ignoran desde el .gitignore que vive dentro de cada una de esas
# carpetas, para que la estructura exista en el repositorio pero su
# contenido nunca se versione.
mlruns/

# Apuntes personales de aprendizaje: no se versionan
/docs/
